# RoomFlip environment variables.
# Copy this file to .env.local for local development. On Vercel, add the same
# keys under Project Settings > Environment Variables.
# Keys prefixed NEXT_PUBLIC_ are exposed to the browser; everything else is server-only.

# --- Site ---------------------------------------------------------------
# Canonical origin of the site, no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (auth, Postgres, Storage) ----------------------------------
# Local values come from `npx supabase status`. Hosted values are under
# Project Settings > API keys in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (service role) key. Bypasses row level security: never expose it.
SUPABASE_SECRET_KEY=

# Show the "Continue with Google" button. Set to true once the Google provider
# is enabled in Supabase with an OAuth client id and secret.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# --- Image generation: fal.ai (milestone 3) ------------------------------
FAL_KEY=
# Without FAL_KEY, local development uses a free mock model; production refuses to render.
# Optional overrides for which model each tier uses, by id from src/lib/config/models.ts:
#   seedream-5-pro-edit, seedream-5-flash-edit, flux-3-klein-edit, muse-image-edit,
#   nano-banana-2-edit, nano-banana-lite-edit, mock
# Leave blank to use the defaults (preview: seedream-5-flash-edit, HD: seedream-5-pro-edit).
RENDER_MODEL_PREVIEW=
RENDER_MODEL_HD=

# --- Image moderation: OpenAI (milestone 3) -------------------------------
# Free endpoint. Without a key, local development skips moderation and production
# refuses uploads.
OPENAI_API_KEY=

# --- Stripe (milestone 6) --------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price IDs for the four things that can be bought (see src/lib/config/pricing.ts).
STRIPE_PRICE_PRO_WEEKLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_PACK_20=
STRIPE_PRICE_PACK_60=

# --- Analytics: PostHog (milestone 7) ---------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Server-side capture for events that must not depend on the browser (purchase, render_completed).
POSTHOG_API_KEY=

# --- Admin and scheduled jobs (milestones 3 and 7) ---------------------------
# Comma-separated emails allowed to open /admin.
ADMIN_EMAILS=
# Shared secret that scheduled job requests must send (stale-job sweeper, monthly credit grants).
CRON_SECRET=
